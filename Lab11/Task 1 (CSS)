* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f3f4fa;
    color: #222;
}

header {
    background: #29245c;
    color: white;
    text-align: center;
    padding: 30px;
}

header h1 {
    margin-bottom: 10px;
}

main {
    max-width: 1100px;
    margin: 40px auto;
    padding: 20px;
}

main h2 {
    text-align: center;
    margin-bottom: 30px;
}

.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
}

.product-card {
    background: white;
    padding: 20px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 5px 20px #00000010;
    transition: 0.3s;
}

.product-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 10px 25px #00000020;
}

.product-image {
    font-size: 65px;
    background: #eeedff;
    padding: 25px;
    border-radius: 12px;
    margin-bottom: 15px;
}

.product-card h3 {
    margin-bottom: 12px;
}

.price {
    color: #6252c9;
    font-size: 21px;
    font-weight: bold;
    margin-bottom: 15px;
}

.quantity {
    margin: 15px 0;
    font-weight: bold;
}

.quantity button {
    padding: 7px 14px;
    margin: 0 10px;
    border: none;
    border-radius: 6px;
    background: #eeedff;
    color: #6252c9;
    font-size: 18px;
    cursor: pointer;
}

.add-btn {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 8px;
    background: #6252c9;
    color: white;
    cursor: pointer;
}

.add-btn:hover {
    background: #44369c;
}
