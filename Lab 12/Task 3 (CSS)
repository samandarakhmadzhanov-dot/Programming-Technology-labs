
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f2f4f8;
    color: #222;
}

header {
    background: #202b46;
    color: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    color: #8fa7ff;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 15px;
}

button {
    background: #526de5;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 7px;
    cursor: pointer;
    font-size: 14px;
    transition: 0.2s;
}

button:hover {
    background: #3c54c5;
}

main {
    width: 88%;
    max-width: 1100px;
    margin: 40px auto;
    min-height: 75vh;
}

.login-page {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 35px 0;
}

.login-card {
    background: white;
    width: 100%;
    max-width: 420px;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 5px 25px rgba(0,0,0,0.07);
}

.login-card h1 {
    margin-bottom: 10px;
    color: #202b46;
}

.login-card > p {
    color: #777;
    margin-bottom: 25px;
}

input {
    width: 100%;
    padding: 14px;
    margin-bottom: 15px;
    border: 1px solid #ddd;
    border-radius: 7px;
    font-size: 15px;
}

#loginBtn {
    width: 100%;
}

#loginMessage {
    margin-top: 15px;
    color: #d33;
}

.demo-accounts {
    background: #f2f4fa;
    padding: 15px;
    border-radius: 8px;
    margin-top: 25px;
    font-size: 13px;
}

.demo-accounts p {
    font-weight: bold;
    margin-bottom: 10px;
}

.demo-accounts span {
    display: block;
    margin-top: 7px;
    color: #555;
}

.welcome {
    background: linear-gradient(135deg, #526de5, #7654c9);
    color: white;
    padding: 35px;
    border-radius: 14px;
    margin-bottom: 25px;
}

.welcome h1 {
    margin-bottom: 10px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.stat-card,
.content-card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.04);
}

.stat-card h3 {
    color: #777;
    font-size: 14px;
    margin-bottom: 12px;
}

.stat-card p {
    font-size: 20px;
    font-weight: bold;
    color: #526de5;
}

.content-card {
    margin-bottom: 25px;
}

.content-card h2 {
    margin-bottom: 12px;
    color: #202b46;
}

.content-card > p {
    color: #777;
    line-height: 1.6;
    margin-bottom: 18px;
}

.lesson {
    background: #f5f6fb;
    padding: 18px;
    border-radius: 9px;
    margin-top: 12px;
}

.lesson h3 {
    color: #526de5;
    margin-bottom: 8px;
}

.lesson p {
    color: #666;
}

.security {
    border-left: 4px solid #e05252;
}

.danger-btn {
    background: #dc4545;
}

.danger-btn:hover {
    background: #b82d2d;
}

.hidden {
    display: none !important;
}

footer {
    text-align: center;
    padding: 25px;
    color: #888;
}

@media (max-width: 700px) {
    header {
        padding: 18px;
        flex-wrap: wrap;
        gap: 15px;
    }

    main {
        width: 92%;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .login-card {
        padding: 25px;
    }
}
