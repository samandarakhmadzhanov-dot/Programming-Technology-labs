
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #141e30, #243b55);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container, .dashboard {
    background: white;
    width: 380px;
    padding: 35px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 5px 25px rgba(0,0,0,0.3);
}

h1 {
    margin-bottom: 25px;
    color: #243b55;
}

input {
    width: 100%;
    padding: 13px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 7px;
    font-size: 15px;
}

button {
    width: 100%;
    padding: 13px;
    background: #243b55;
    color: white;
    border: none;
    border-radius: 7px;
    cursor: pointer;
    margin-top: 12px;
    font-size: 15px;
}

button:hover {
    background: #375b80;
}

.logout {
    background: #d93636;
}

.logout:hover {
    background: #a82020;
}

.hidden {
    display: none;
}

#message {
    margin-top: 15px;
    color: red;
}

.session-box {
    background: #eef3f8;
    padding: 20px;
    border-radius: 10px;
    margin: 25px 0;
}

.session-box h3 {
    font-size: 17px;
    margin-bottom: 15px;
}

#timer {
    font-size: 38px;
    font-weight: bold;
    color: #208b55;
    margin-bottom: 10px;
}

.session-box p {
    font-size: 13px;
    color: #666;
}
