* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f3f5fa;
    color: #202b45;
}

.hidden {
    display: none !important;
}

/* Авторизация */

.login-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #101b3d, #314c85);
    padding: 20px;
}

.login-box {
    background: white;
    padding: 40px;
    width: 100%;
    max-width: 400px;
    border-radius: 18px;
    text-align: center;
    box-shadow: 0 15px 40px #0003;
}

.login-box h1 {
    font-size: 32px;
    margin-bottom: 10px;
}

h1 span, header h2 span {
    color: #5278df;
}

.login-box p {
    color: #777;
    margin-bottom: 25px;
}

input {
    width: 100%;
    padding: 14px;
    margin-bottom: 15px;
    border: 1px solid #ddd;
    border-radius: 9px;
    font-size: 15px;
}

button {
    border: none;
    cursor: pointer;
    border-radius: 9px;
    padding: 13px 22px;
    font-weight: bold;
    transition: 0.3s;
}

.login-box button {
    width: 100%;
    background: #5278df;
    color: white;
}

button:hover {
    opacity: 0.85;
    transform: translateY(-2px);
}

#errorMessage {
    color: red;
    margin-top: 15px;
}

/* Кабинет */

header {
    background: white;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 3px 15px #00000008;
}

header h2 {
    font-size: 26px;
}

.profile {
    display: flex;
    align-items: center;
    gap: 20px;
}

#logoutBtn {
    background: #ffe8e8;
    color: #d93636;
}

main {
    max-width: 1200px;
    margin: auto;
    padding: 40px 25px;
}

.welcome {
    background: linear-gradient(120deg, #263e78, #5278df);
    padding: 35px;
    color: white;
    border-radius: 16px;
    margin-bottom: 30px;
}

.welcome h1 {
    font-size: 30px;
    margin-bottom: 10px;
}

.welcome p {
    color: #dce5ff;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 40px;
}

.stat-card {
    background: white;
    padding: 25px;
    border-radius: 14px;
    box-shadow: 0 4px 15px #00000008;
}

.stat-card h3 {
    color: #777;
    font-size: 15px;
}

.stat-card p {
    font-size: 28px;
    font-weight: bold;
    margin-top: 15px;
    color: #5278df;
}

.stat-card .active {
    color: #20a56b;
    font-size: 20px;
}

.lessons h2 {
    font-size: 25px;
}

.subtitle {
    color: #888;
    margin: 10px 0 25px;
}

.lesson-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.lesson-card {
    background: white;
    padding: 25px;
    border-radius: 14px;
    border-left: 5px solid #5278df;
    box-shadow: 0 4px 15px #00000008;
}

.lesson-card h3 {
    margin-bottom: 15px;
}

.lesson-card p {
    color: #777;
    margin: 8px 0;
}

.lesson-status {
    display: inline-block;
    background: #e7f8ef;
    color: #15965c;
    padding: 7px 12px;
    border-radius: 20px;
    font-size: 12px;
    margin-top: 12px;
}

footer {
    text-align: center;
    padding: 25px;
    color: #999;
}

@media (max-width: 700px) {
    header {
        padding: 18px;
    }

    .profile {
        gap: 10px;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .lesson-list {
        grid-template-columns: 1fr;
    }

    .welcome h1 {
        font-size: 23px;
    }

    main {
        padding: 25px 15px;
    }

    .login-box {
        padding: 25px;
    }
}

