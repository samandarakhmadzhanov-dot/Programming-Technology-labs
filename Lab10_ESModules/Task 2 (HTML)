<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Поиск контактов</title>
    <link rel="stylesheet" href="styles.css">
    <script type="module" src="script.js"></script>
</head>
<body>

    <div class="container">
        <h1>Поиск контактов</h1>
        <p>Найдите нужный контакт по имени или номеру телефона</p>

        <input
            type="text"
            id="searchInput"
            placeholder="Введите имя или номер..."
        >

        <div id="counter">Всего контактов: 0</div>

        <ul id="contactList"></ul>

        <div id="empty">Контакты не найдены</div>
    </div>

</body>
</html>
