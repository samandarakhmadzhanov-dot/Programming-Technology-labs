
const form = document.querySelector("#searchForm");
const input = document.querySelector("#userId");
const button = document.querySelector("#searchBtn");
const status = document.querySelector("#status");
const result = document.querySelector("#result");
const count = document.querySelector("#count");
const historyContainer = document.querySelector("#history");
const clearHistoryBtn = document.querySelector("#clearHistoryBtn");

let requests = 0;
let history = [];
let cachedUsers = {};

function showStatus(message, type = "") {
    status.textContent = message;
    status.className = type;
}

function displayUser(user) {
    result.replaceChildren();

    const card = document.createElement("div");
    card.className = "card";

    const name = document.createElement("h2");
    name.textContent = user.name;

    const email = document.createElement("p");
    const emailLabel = document.createElement("span");
    emailLabel.className = "label";
    emailLabel.textContent = "Email: ";
    email.append(emailLabel, document.createTextNode(user.email || "Нет данных"));

    const city = document.createElement("p");
    const cityLabel = document.createElement("span");
    cityLabel.className = "label";
    cityLabel.textContent = "Город: ";
    city.append(
        cityLabel,
        document.createTextNode(user.address?.city || "Нет данных")
    );

    const company = document.createElement("p");
    const companyLabel = document.createElement("span");
    companyLabel.className = "label";
    companyLabel.textContent = "Компания: ";
    company.append(
        companyLabel,
        document.createTextNode(user.company?.name || "Нет данных")
    );

    card.append(name, email, city, company);
    result.append(card);
}

function renderHistory() {
    historyContainer.replaceChildren();

    if (history.length === 0) {
        const empty = document.createElement("p");
        empty.className = "empty-history";
        empty.textContent = "История пока пуста";
        historyContainer.append(empty);
        return;
    }

    history.forEach(user => {
        const item = document.createElement("div");
        item.className = "history-item";

        const info = document.createElement("div");
        info.className = "history-info";

        const name = document.createElement("strong");
        name.textContent = user.name;

        const details = document.createElement("span");
        details.textContent = `ID: ${user.id} · ${user.address?.city || "Город неизвестен"}`;

        const openButton = document.createElement("button");
        openButton.type = "button";
        openButton.textContent = "Открыть";

        openButton.addEventListener("click", () => {
            input.value = user.id;
            displayUser(user);
            showStatus("Пользователь открыт из истории без нового запроса.", "success");
        });

        info.append(name, details);
        item.append(info, openButton);
        historyContainer.append(item);
    });
}

function addToHistory(user) {
    history = history.filter(item => item.id !== user.id);
    history.unshift(user);
    history = history.slice(0, 5);
    renderHistory();
}

form.addEventListener("submit", async function(event) {
    event.preventDefault();

    const id = Number(input.value);

    if (!Number.isInteger(id) || id < 1 || id > 10) {
        showStatus("Введите целый ID от 1 до 10.", "error");
        result.replaceChildren();
        return;
    }

    if (cachedUsers[id]) {
        displayUser(cachedUsers[id]);
        addToHistory(cachedUsers[id]);
        showStatus("Пользователь найден в кэше. Новый запрос не отправлялся.", "success");
        return;
    }

    button.disabled = true;
    showStatus("Загрузка данных...", "loading");
    result.replaceChildren();

    requests++;
    count.textContent = requests;

    try {
        const response = await fetch(
            `https://jsonplaceholder.typicode.com/users/${id}`
        );

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const user = await response.json();

        if (!user.id) {
            showStatus("Пользователь не найден.", "error");
            return;
        }

        cachedUsers[user.id] = user;
        displayUser(user);
        addToHistory(user);
        showStatus("Данные успешно загружены!", "success");

    } catch (error) {
        showStatus(
            "Ошибка загрузки. Проверьте интернет и попробуйте снова.",
            "error"
        );
    } finally {
        button.disabled = false;
    }
});

clearHistoryBtn.addEventListener("click", () => {
    history = [];
    renderHistory();
    showStatus("История поиска очищена.", "success");
});

renderHistory();
