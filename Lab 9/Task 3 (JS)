const albumSelect = document.getElementById("albumSelect");
const photoGrid = document.getElementById("photoGrid");
const status = document.getElementById("status");
const errorBox = document.getElementById("errorBox");
const errorMessage = document.getElementById("errorMessage");
const retryBtn = document.getElementById("retryBtn");
const photoCounter = document.getElementById("photoCounter");
const pagination = document.getElementById("pagination");
const pageNumbers = document.getElementById("pageNumbers");
const prevBtn = document.getElementById("prevBtn");
const nextBtn = document.getElementById("nextBtn");
const allPhotosBtn = document.getElementById("allPhotosBtn");
const favoritesBtn = document.getElementById("favoritesBtn");
const favoritesCount = document.getElementById("favoritesCount");

const photosPerPage = 12;

let photos = [];
let currentPage = 1;
let loading = false;
let requestNumber = 0;
let showFavorites = false;
let favorites = [];

try {
    const savedFavorites = JSON.parse(
        localStorage.getItem("favorites") || "[]"
    );

    if (Array.isArray(savedFavorites)) {
        favorites = savedFavorites.filter(id => Number.isInteger(id));
    }
} catch {
    favorites = [];
}

function updateFavoritesCount() {
    favoritesCount.textContent = favorites.length;
}

function updateFilterButtons() {
    allPhotosBtn.classList.toggle("active", !showFavorites);
    favoritesBtn.classList.toggle("active", showFavorites);
}

async function loadPhotos() {
    if (loading) return;

    loading = true;
    const currentRequest = ++requestNumber;
    const albumId = albumSelect.value;

    photoGrid.innerHTML = "";
    pageNumbers.innerHTML = "";
    errorBox.hidden = true;
    pagination.hidden = true;
    photoCounter.textContent = "Загрузка...";
    status.hidden = false;
    status.className = "status loading";
    status.textContent = "Загружаем фотографии...";

    try {
        const response = await fetch(
            `https://jsonplaceholder.typicode.com/photos?albumId=${albumId}`
        );

        if (!response.ok) {
            throw new Error(`Ошибка сервера: ${response.status}`);
        }

        const data = await response.json();

        if (!Array.isArray(data)) {
            throw new Error("Получены некорректные данные");
        }

        if (currentRequest !== requestNumber) return;

        photos = data;
        currentPage = 1;

        status.hidden = true;
        renderPhotos();
    } catch (error) {
        if (currentRequest !== requestNumber) return;

        photos = [];
        photoGrid.innerHTML = "";
        photoCounter.textContent = "Фотографий: 0";
        status.hidden = true;
        pagination.hidden = true;
        errorBox.hidden = false;

        errorMessage.textContent =
            error instanceof TypeError
                ? "Не удалось подключиться к серверу. Проверь интернет и попробуй снова."
                : error.message;
    } finally {
        if (currentRequest === requestNumber) {
            loading = false;
        }
    }
}

function renderPhotos() {
    photoGrid.innerHTML = "";

    const visiblePhotos = showFavorites
        ? photos.filter(photo => favorites.includes(photo.id))
        : photos;

    const totalPages = Math.ceil(visiblePhotos.length / photosPerPage);

    if (totalPages > 0) {
        currentPage = Math.min(currentPage, totalPages);
    } else {
        currentPage = 1;
    }

    photoCounter.textContent = showFavorites
        ? `Избранное: ${visiblePhotos.length}`
        : `Фотографий: ${photos.length}`;

    if (visiblePhotos.length === 0) {
        status.hidden = false;
        status.className = "status";
        status.textContent = showFavorites
            ? "В этом альбоме пока нет избранных фотографий."
            : "Фотографии не найдены.";

        pagination.hidden = true;
        updateFavoritesCount();
        updateFilterButtons();
        return;
    }

    status.hidden = true;

    const start = (currentPage - 1) * photosPerPage;
    const pagePhotos = visiblePhotos.slice(start, start + photosPerPage);

    pagePhotos.forEach(photo => {
        const card = document.createElement("article");
        card.className = "photo-card";

        const image = document.createElement("img");
        image.src = photo.thumbnailUrl;
        image.alt = photo.title;
        image.loading = "lazy";

        image.onerror = () => {
            image.removeAttribute("src");
            image.alt = "Изображение недоступно";
        };

        const info = document.createElement("div");
        info.className = "photo-info";

        const title = document.createElement("h3");
        title.textContent = photo.title;

        const album = document.createElement("p");
        album.textContent = `Альбом ${photo.albumId} · Фото №${photo.id}`;

        const favoriteButton = document.createElement("button");
        favoriteButton.className = "favorite-btn";

        function updateFavoriteButton() {
            const selected = favorites.includes(photo.id);

            favoriteButton.textContent = selected
                ? "♥ В избранном"
                : "♡ В избранное";

            favoriteButton.classList.toggle("selected", selected);
        }

        updateFavoriteButton();

        favoriteButton.addEventListener("click", () => {
            if (favorites.includes(photo.id)) {
                favorites = favorites.filter(id => id !== photo.id);
            } else {
                favorites.push(photo.id);
            }

            try {
                localStorage.setItem("favorites", JSON.stringify(favorites));
            } catch {
                errorBox.hidden = false;
                errorMessage.textContent =
                    "Не удалось сохранить избранное в браузере.";
            }

            updateFavoritesCount();

            if (showFavorites) {
                renderPhotos();
            } else {
                updateFavoriteButton();
            }
        });

        info.append(title, album, favoriteButton);
        card.append(image, info);
        photoGrid.appendChild(card);
    });

    renderPagination(totalPages);
    updateFavoritesCount();
    updateFilterButtons();
}

function renderPagination(totalPages) {
    pagination.hidden = totalPages <= 1;
    pageNumbers.innerHTML = "";

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;

    for (let page = 1; page <= totalPages; page++) {
        const button = document.createElement("button");

        button.className = "page-number";
        button.textContent = page;
        button.setAttribute("aria-label", `Страница ${page}`);

        if (page === currentPage) {
            button.classList.add("active");
            button.setAttribute("aria-current", "page");
        }

        button.addEventListener("click", () => {
            currentPage = page;
            renderPhotos();
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        pageNumbers.appendChild(button);
    }
}

albumSelect.addEventListener("change", loadPhotos);
retryBtn.addEventListener("click", loadPhotos);

allPhotosBtn.addEventListener("click", () => {
    showFavorites = false;
    currentPage = 1;
    renderPhotos();
});

favoritesBtn.addEventListener("click", () => {
    showFavorites = true;
    currentPage = 1;
    renderPhotos();
});

prevBtn.addEventListener("click", () => {
    if (currentPage > 1) {
        currentPage--;
        renderPhotos();
    }
});

nextBtn.addEventListener("click", () => {
    const visiblePhotos = showFavorites
        ? photos.filter(photo => favorites.includes(photo.id))
        : photos;

    const totalPages = Math.ceil(visiblePhotos.length / photosPerPage);

    if (currentPage < totalPages) {
        currentPage++;
        renderPhotos();
    }
});

updateFavoritesCount();
loadPhotos();
