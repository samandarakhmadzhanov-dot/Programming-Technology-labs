const albumSelect = document.getElementById("albumSelect");
const photoGrid = document.getElementById("photoGrid");
const status = document.getElementById("status");
const errorBox = document.getElementById("errorBox");
const errorMessage = document.getElementById("errorMessage");
const retryBtn = document.getElementById("retryBtn");
const photoCounter = document.getElementById("photoCounter");
const pagination = document.getElementById("pagination");
const pageNumbers = document.getElementById("pageNumbers");
const prevBtn = document.getElementById("prevBtn");
const nextBtn = document.getElementById("nextBtn");

const photosPerPage = 12;

let photos = [];
let currentPage = 1;
let loading = false;
let requestNumber = 0;

async function loadPhotos() {
    if (loading) return;

    loading = true;
    const currentRequest = ++requestNumber;
    const albumId = albumSelect.value;

    photoGrid.innerHTML = "";
    pageNumbers.innerHTML = "";
    errorBox.hidden = true;
    pagination.hidden = true;
    photoCounter.textContent = "Загрузка...";
    status.hidden = false;
    status.className = "status loading";
    status.textContent = "Загружаем фотографии...";

    try {
        const response = await fetch(
            `https://jsonplaceholder.typicode.com/photos?albumId=${albumId}`
        );

        if (!response.ok) {
            throw new Error(`Ошибка сервера: ${response.status}`);
        }

        const data = await response.json();

        if (!Array.isArray(data)) {
            throw new Error("Получены некорректные данные");
        }

        if (currentRequest !== requestNumber) return;

        photos = data;
        currentPage = 1;

        status.hidden = true;
        photoCounter.textContent = `Фотографий: ${photos.length}`;

        if (photos.length === 0) {
            status.hidden = false;
            status.className = "status";
            status.textContent = "В этом альбоме фотографий нет.";
            return;
        }

        renderPhotos();
    } catch (error) {
        if (currentRequest !== requestNumber) return;

        photos = [];
        photoCounter.textContent = "Фотографий: 0";
        status.hidden = true;
        errorBox.hidden = false;
        errorMessage.textContent =
            error.message === "Failed to fetch"
                ? "Проверь подключение к интернету и попробуй снова."
                : error.message;
    } finally {
        if (currentRequest === requestNumber) {
            loading = false;
        }
    }
}

function renderPhotos() {
    photoGrid.innerHTML = "";

    const start = (currentPage - 1) * photosPerPage;
    const pagePhotos = photos.slice(start, start + photosPerPage);

    pagePhotos.forEach(photo => {
        const card = document.createElement("article");
        card.className = "photo-card";

        const image = document.createElement("img");
        image.src = photo.thumbnailUrl;
        image.alt = photo.title;
        image.loading = "lazy";

        image.onerror = () => {
            image.removeAttribute("src");
            image.alt = "Изображение недоступно";
        };

        const info = document.createElement("div");
        info.className = "photo-info";

        const title = document.createElement("h3");
        title.textContent = photo.title;

        const album = document.createElement("p");
        album.textContent = `Альбом ${photo.albumId} · Фото №${photo.id}`;

        info.append(title, album);
        card.append(image, info);
        photoGrid.appendChild(card);
    });

    renderPagination();
}

function renderPagination() {
    const totalPages = Math.ceil(photos.length / photosPerPage);

    pagination.hidden = totalPages <= 1;
    pageNumbers.innerHTML = "";

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;

    for (let page = 1; page <= totalPages; page++) {
        const button = document.createElement("button");

        button.className = "page-number";
        button.textContent = page;
        button.setAttribute("aria-label", `Страница ${page}`);

        if (page === currentPage) {
            button.classList.add("active");
            button.setAttribute("aria-current", "page");
        }

        button.addEventListener("click", () => {
            currentPage = page;
            renderPhotos();
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        pageNumbers.appendChild(button);
    }
}

albumSelect.addEventListener("change", loadPhotos);

retryBtn.addEventListener("click", loadPhotos);

prevBtn.addEventListener("click", () => {
    if (currentPage > 1) {
        currentPage--;
        renderPhotos();
    }
});

nextBtn.addEventListener("click", () => {
    const totalPages = Math.ceil(photos.length / photosPerPage);

    if (currentPage < totalPages) {
        currentPage++;
        renderPhotos();
    }
});

loadPhotos();
