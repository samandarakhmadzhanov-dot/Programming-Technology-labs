<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Поиск пользователя</title>
    <link rel="stylesheet" href="styles.css">
    <script src="script.js" defer></script>
</head>
<body>
    <div class="container">
        <div class="avatar">♙</div>

        <h1>Поиск <span>пользователя</span></h1>
        <p class="description">
            Введите ID пользователя от 1 до 10
        </p>

        <form id="searchForm">
            <input type="number" id="userId"
                   min="1" max="10"
                   placeholder="Введите ID (1–10)" required>
            <button type="submit" id="searchBtn">Найти</button>
        </form>

        <p id="status" role="status" aria-live="polite">
            Введите ID и нажмите «Найти»
        </p>

        <div id="result"></div>

        <section class="history-section">
            <div class="history-header">
                <h2>История поиска</h2>
                <button type="button" id="clearHistoryBtn" class="clear-btn">
                    Очистить
                </button>
            </div>
            <div id="history" class="history-list">
                <p class="empty-history">История пока пуста</p>
            </div>
        </section>

        <div class="footer">
            Количество запросов: <span id="count">0</span>
        </div>
    </div>
</body>
</html>
