<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Поиск пользователя</title>
    <link rel="stylesheet" href="styles.css">
    <script src="script.js" defer></script>
</head>
<body>
    <div class="container">
        <div class="avatar">♙</div>

        <h1>Поиск <span>пользователя</span></h1>
        <p class="description">
            Введите ID пользователя от 1 до 10
        </p>

        <form id="searchForm">
            <input type="number" id="userId"
                   min="1" max="10"
                   placeholder="Введите ID (1–10)" required>
            <button type="submit" id="searchBtn">Найти</button>
        </form>

        <p id="status">Введите ID и нажмите «Найти»</p>

        <div id="result"></div>

        <div class="footer">
            Количество запросов: <span id="count">0</span>
        </div>
    </div>
</body>
</html>
