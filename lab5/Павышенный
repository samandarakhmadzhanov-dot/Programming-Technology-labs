expenses = []

while True:
    print("\n--- РАСХОДЫ ---")
    print("1. Добавить расход")
    print("2. Показать расходы")
    print("3. Удалить расход")
    print("4. Показать общую сумму")
    print("5. Выход")

    choice = input("Выберите действие: ")

    if choice == "1":
        name = input("Название расхода: ")
        amount = float(input("Сумма: "))

        expenses.append([name, amount])
        print("Расход добавлен!")

    elif choice == "2":
        if not expenses:
            print("Список расходов пуст.")
        else:
            for i, expense in enumerate(expenses, 1):
                print(f"{i}. {expense[0]} — {expense[1]} тг")

    elif choice == "3":
        if not expenses:
            print("Список расходов пуст.")
        else:
            for i, expense in enumerate(expenses, 1):
                print(f"{i}. {expense[0]} — {expense[1]} тг")

            number = int(input("Введите номер расхода для удаления: "))

            if 1 <= number <= len(expenses):
                deleted = expenses.pop(number - 1)
                print(f"Удалён расход: {deleted[0]}")
            else:
                print("Неверный номер.")

    elif choice == "4":
        total = sum(expense[1] for expense in expenses)
        print(f"Общая сумма: {total} тг")

    elif choice == "5":
        print("Программа завершена.")
        break

    else:
        print("Неверный выбор.")
