import random

number = random.randint(1, 100)

print("Я загадал число от 1 до 100.")

while True:
    guess = int(input("Угадайте число: "))

    if guess < number:
        print("Больше!")
    elif guess > number:
        print("Меньше!")
    else:
        print("Поздравляю! Вы угадали!")
        break
