const tabs = document.querySelectorAll(".tab");
const content = document.getElementById("content");

const projects = [
    {
        title: "Сайт магазина",
        description: "Сайт с товарами и ценами."
    },
    {
        title: "Калькулятор",
        description: "Программа для вычислений."
    },
    {
        title: "Моё портфолио",
        description: "Сайт с информацией обо мне."
    }
];

function showProjects() {
    content.innerHTML = '<div class="projects"></div>';

    const projectsBox = content.querySelector(".projects");

    projects.forEach(project => {
        const card = document.createElement("div");
        card.className = "card";

        const title = document.createElement("h3");
        title.textContent = project.title;

        const description = document.createElement("p");
        description.textContent = project.description;

        card.append(title, description);
        projectsBox.appendChild(card);
    });
}

function showPage(page) {
    if (page === "projects") {
        showProjects();
    } else if (page === "skills") {
        content.innerHTML = `
            <h2>Мои навыки</h2>
            <p>HTML — создание страниц</p>
            <p>CSS — оформление сайтов</p>
            <p>JavaScript — интерактивность</p>
            <p>Python — основы программирования</p>
        `;
    } else {
        content.innerHTML = `
            <h2>Обо мне</h2>
            <p>Привет! Я студент и изучаю программирование.</p>
            <p>Мне интересно создавать сайты и новые проекты.</p>
            <p>Моя цель — стать хорошим IT-специалистом.</p>
        `;
    }
}

tabs.forEach(tab => {
    tab.addEventListener("click", () => {
        tabs.forEach(item => item.classList.remove("active"));
        tab.classList.add("active");

        showPage(tab.dataset.tab);
    });
});

showProjects();

