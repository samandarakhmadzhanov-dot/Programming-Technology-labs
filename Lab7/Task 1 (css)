* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f0f2f5;
    color: #222;
}

.container {
    width: 90%;
    max-width: 700px;
    margin: 60px auto;
    padding: 30px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 4px 15px #00000015;
}

h1 {
    text-align: center;
    color: #e63946;
}

.subtitle {
    text-align: center;
    color: #777;
}

.tabs {
    display: flex;
    gap: 10px;
    margin: 30px 0 20px;
}

.tab {
    flex: 1;
    padding: 12px 5px;
    border: none;
    border-radius: 8px;
    background: #e9ecef;
    cursor: pointer;
    font-size: 14px;
    transition: 0.3s;
}

.tab:hover {
    background: #ffd6d9;
}

.tab.active {
    background: #e63946;
    color: white;
    font-weight: bold;
}

.content {
    padding: 20px;
    background: #fafafa;
    border-radius: 10px;
    min-height: 180px;
    line-height: 1.7;
}

.content h2 {
    color: #e63946;
}

@media (max-width: 500px) {
    .container {
        padding: 15px;
    }

    .tabs {
        flex-direction: column;
    }
}
