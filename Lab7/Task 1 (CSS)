body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
    color: #1e293b;
}

.container {
    max-width: 800px;
    margin: 50px auto;
    padding: 25px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 4px 15px #00000015;
}

h1, .subtitle {
    text-align: center;
}

h1 {
    color: #2563eb;
}

.subtitle {
    color: #64748b;
}

.tabs {
    display: flex;
    gap: 10px;
    margin: 30px 0;
}

.tab {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 8px;
    background: #e2e8f0;
    cursor: pointer;
    font-size: 15px;
}

.tab:hover {
    background: #bfdbfe;
}

.tab.active {
    background: #2563eb;
    color: white;
}

.projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
}

.card {
    padding: 20px;
    background: #eff6ff;
    border-radius: 10px;
    border-left: 4px solid #2563eb;
}

.card h3 {
    margin-top: 0;
    color: #2563eb;
}

#content {
    line-height: 1.6;
}

@media (max-width: 500px) {
    .container {
        margin: 20px;
        padding: 15px;
    }

    .tabs {
        flex-direction: column;
    }
}

