body {
    font-family: Arial, sans-serif;
    background: #eef1f5;
    margin: 0;
    padding: 30px 15px;
}

.container {
    max-width: 600px;
    margin: auto;
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 15px #ccc;
}

h1 {
    text-align: center;
    color: #222;
}

.form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
}

input, select, button {
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 15px;
}

button {
    background: #2563eb;
    color: white;
    border: none;
    cursor: pointer;
}

button:hover {
    background: #1d4ed8;
}

#filter {
    width: 100%;
    margin-bottom: 15px;
}

.movie {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 15px;
    margin-bottom: 10px;
    background: #f5f7fa;
    border-radius: 8px;
}

.movie h3 {
    margin: 0 0 8px;
}

.movie p {
    margin: 0;
    color: #555;
}

.delete {
    background: #dc2626;
    flex-shrink: 0;
}

.delete:hover {
    background: #b91c1c;
}
